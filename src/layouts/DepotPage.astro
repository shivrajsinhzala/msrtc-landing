---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import AccuracyNote from '../components/AccuracyNote.astro';
import { ROUTES } from '../data/routes.data.mjs';
import { SITE } from '../config/site.mjs';

interface Stand { label: string; numbers: string[]; }
interface Props {
  depot: { city: string; region: string; alsoKnownAs?: string; stands: Stand[] };
  cityName: string;
  path: string;
  siblingLinks: { href: string; label: string }[];
}

const { depot, cityName, path, siblingLinks } = Astro.props;
const { stands } = depot;
const multi = stands.length > 1;
const tel = (n: string) => n.replace(/[^0-9]/g, '');

const primaryStand = stands[0];
const primaryNumber = primaryStand.numbers[0];

const baseTitle = `${cityName} Bus Stand Contact Number: ${primaryNumber}`;
const title = baseTitle.length <= 52
  ? `${baseTitle} — MSRTC`
  : baseTitle.length <= 60 ? baseTitle : `${cityName} Bus Stand Number: ${primaryNumber}`;
const description = `MSRTC ${cityName} bus stand enquiry number ${primaryNumber}. Tap-to-call numbers for ${stands.length} stand${multi ? 's' : ''}, plus the toll-free helpline 1800-22-1250.`;
const quickAnswer = `The main listed MSRTC enquiry number for ${cityName} is ${primaryNumber}, at ${primaryStand.label}. If the line is busy or unanswered, call the MSRTC toll-free helpline on 1800-22-1250.`;

// Connected express routes originating or ending at this depot
const connectedRoutes = ROUTES.filter(
  (r) =>
    r.originCity.toLowerCase().includes(depot.city.toLowerCase()) ||
    r.destinationCity.toLowerCase().includes(depot.city.toLowerCase()) ||
    r.originCity.toLowerCase().includes(cityName.toLowerCase()) ||
    r.destinationCity.toLowerCase().includes(cityName.toLowerCase())
);

const breadcrumbs = [
  { label: 'Bus Stations', href: '/stations' },
  { label: `${cityName} Bus Station`, href: path },
];

const faqs = [
  {
    q: `What is the published MSRTC enquiry number for ${cityName} bus station?`,
    a: `The primary telephone inquiry desk at ${cityName} bus station is ${primaryNumber}. For 24x7 customer support across Maharashtra, passengers can also dial toll-free 1800-22-1250.`,
  },
  {
    q: `Which ${cityName} bus stands are listed here?`,
    a: `This page lists ${stands.length} bus stand${multi ? 's' : ''} for ${cityName}: ${stands.map(s => s.label).join(', ')}.`,
  },
  {
    q: `What if the local ${cityName} enquiry line is busy?`,
    a: `During morning and evening rush hours, local station lines can experience high traffic. In that case, call the 24x7 central toll-free helpline at 1800-22-1250 or check schedules on the official portal msrtc.maharashtra.gov.in.`,
  },
  {
    q: `Can I reserve MSRTC bus tickets from ${cityName} online?`,
    a: `Yes, seat bookings for Shivneri, Shivshahi, and Ordinary buses departing ${cityName} can be made on npublic.msrtcors.com or via the MSRTC Bus Reservation mobile app.`,
  },
];

const regionalTerms = `${cityName} एसटी बस चौकशी क्रमांक, ${cityName} बस स्थानक संपर्क, एसटी वेळापत्रक, शिवशाही बस`;
const keywords = `${cityName} bus stand contact number, ${cityName} bus stand enquiry number, msrtc ${cityName} phone number, ${cityName} st stand inquiry, ${cityName} bus timetable, ${regionalTerms}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BusStation',
    url: `${SITE}${path}`,
    name: `${cityName} MSRTC Bus Station`,
    alternateName: `${cityName} एसटी बस स्थानक`,
    telephone: primaryNumber,
    address: {
      '@type': 'PostalAddress',
      addressLocality: cityName,
      addressRegion: 'Maharashtra',
      addressCountry: 'IN',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<Base title={title} description={description} keywords={keywords} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <div class="wrap" style="padding-top:1rem;padding-bottom:3rem;">

    <!-- Depot Hero Header -->
    <section style="margin-bottom:2rem;">
      <div style="font-family:var(--font-mono);font-size:0.75rem;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.35rem;">
        Independent MSRTC Bus Stand Directory
      </div>
      <h1 class="section-title" style="font-size:2.25rem;margin-bottom:0.4rem;">
        {cityName} Bus Station Contact Numbers
      </h1>
      <p style="font-size:0.95rem;font-weight:600;color:var(--primary-blue);margin-bottom:0.75rem;">
        {cityName} एसटी बस स्थानक चौकशी क्रमांक व वेळापत्रक
      </p>
      <p class="section-subtitle" style="font-size:1.05rem;line-height:1.6;max-width:760px;">
        {quickAnswer}
      </p>

      <!-- Key Numbers Call Action Strip -->
      <div class="dial-action-strip" style="margin-top:1.25rem;">
        <div class="dial-strip-header">
          <div class="dial-strip-title">{cityName} Central Inquiry Desk</div>
          <div class="dial-strip-sub">Direct telephone counter at {primaryStand.label}</div>
        </div>
        <div class="call-button-group">
          <a class="btn-dial" href={`tel:${tel(primaryNumber)}`}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Call Desk: {primaryNumber}</span>
          </a>
          <a class="btn-dial secondary" href="tel:1800221250">
            <span>24x7 Helpline: 1800-22-1250</span>
          </a>
          <a class="btn-dial secondary" href="https://npublic.msrtcors.com" target="_blank" rel="noopener noreferrer">
            <span>Online Reservation</span>
          </a>
        </div>
      </div>
      <AccuracyNote />
    </section>

    <!-- Above-The-Fold Ad Slot -->
    <AdSlot slotId="5213571252" label="Advertisement" />

    <!-- Bus Stands Directory Table / Cards -->
    <section aria-labelledby="stands-heading" style="margin:2.5rem 0;">
      <h2 class="section-title" id="stands-heading" style="font-size:1.55rem;margin-bottom:0.35rem;">
        {cityName} Bus Terminals &amp; Inquiry Counters ({stands.length})
      </h2>
      <p class="section-subtitle" style="margin-bottom:1rem;">
        Platform inquiry desks and control room phone lines across {cityName}:
      </p>

      <div class="desktop-table-only table-container">
        <table class="depot-table">
          <thead>
            <tr>
              <th scope="col">Terminal / Stand Name</th>
              <th scope="col">Counter Enquiry Numbers</th>
              <th scope="col">Quick Dial Action</th>
            </tr>
          </thead>
          <tbody>
            {stands.map((s) => (
              <tr>
                <td class="depot-name-cell">
                  <strong>{s.label}</strong>
                </td>
                <td class="depot-number-cell">
                  <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
                    {s.numbers.map((n) => (
                      <a href={`tel:${tel(n)}`} style="font-family:var(--font-mono);font-weight:600;color:var(--primary-blue);">
                        {n}
                      </a>
                    ))}
                  </div>
                </td>
                <td>
                  <a class="btn-dial" href={`tel:${tel(s.numbers[0])}`} style="padding:0.35rem 0.75rem;font-size:0.78rem;">
                    Call Counter
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile View Cards -->
      <div class="mobile-cards-only" style="margin:1rem 0;">
        {stands.map((s) => (
          <div class="rtc-card" style="padding:1rem;min-height:auto;margin-bottom:0.75rem;">
            <h3 style="font-size:1.05rem;margin-bottom:0.5rem;color:var(--ink);">{s.label}</h3>
            <div style="display:flex;flex-direction:column;gap:0.5rem;">
              {s.numbers.map((n) => (
                <a class="btn-dial" href={`tel:${tel(n)}`} style="font-size:0.85rem;justify-content:center;">
                  Call {n}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Connected Express Bus Routes -->
    {connectedRoutes.length > 0 && (
      <section style="margin:2.5rem 0;">
        <h2 class="section-title" style="font-size:1.55rem;margin-bottom:0.35rem;">
          Popular Bus Timetables from {cityName}
        </h2>
        <p class="section-subtitle" style="margin-bottom:1rem;">
          Direct intercity express schedules departing or arriving at {cityName}:
        </p>
        <div class="routes-grid">
          {connectedRoutes.map((r) => (
            <a class="route-card" href={`/routes/${r.slug}`}>
              <div>
                <div class="route-card-header">
                  <span class="route-card-operator">{r.corporation}</span>
                  <span class="route-card-duration">{r.durationHours}</span>
                </div>
                <h3 class="route-card-corridor">{r.originCity} ⇄ {r.destinationCity}</h3>
                <p class="route-card-specs">
                  {r.distanceKm} km · {r.frequency}
                </p>
              </div>
              <div class="route-card-footer">
                <span class="route-card-fare">Approx. from {r.fares[0].price}</span>
                <span class="route-card-action">View schedule</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Mid-Content Ad Slot -->
    <AdSlot slotId="5213571252" label="Advertisement" />

    <!-- Frequently Asked Questions -->
    <section aria-labelledby="faq-heading" style="margin:2.5rem 0;">
      <h2 class="section-title" id="faq-heading" style="font-size:1.55rem;margin-bottom:1rem;">
        Frequently Asked Questions — {cityName} Bus Stand
      </h2>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        {faqs.map((f) => (
          <div class="card" style="margin:0;">
            <h3 style="font-size:1.02rem;margin-bottom:0.35rem;color:var(--ink);">{f.q}</h3>
            <p style="font-size:0.9rem;line-height:1.6;color:var(--slate);margin:0;">{f.a}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Sibling Division Links (Zero Orphan Pages) -->
    {siblingLinks.length > 0 && (
      <section style="margin:2.5rem 0;">
        <h2 class="section-title" style="font-size:1.35rem;margin-bottom:1rem;">
          Other Maharashtra Transport Divisions
        </h2>
        <div class="rtc-grid" style="grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));">
          {siblingLinks.map((s) => (
            <a class="rtc-card" href={s.href} style="padding:1rem;">
              <h3 class="rtc-card-title" style="font-size:1rem;">{s.label}</h3>
              <div class="rtc-card-meta" style="margin-top:0.5rem;">
                <span style="color:var(--primary-blue);font-weight:600;font-size:0.82rem;">View phone directory</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Pre-Footer Ad Slot -->
    <AdSlot slotId="5213571252" label="Sponsored" />

  </div>

</Base>
