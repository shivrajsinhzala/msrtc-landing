---
import { SITE, SITE_CONFIG, LAST_UPDATED } from '../config/site.mjs';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  path: string;
  jsonLd?: unknown[];
  htmlLang?: string;
  breadcrumbs?: { label: string; href: string }[];
}

const {
  title,
  description,
  keywords = 'msrtc bus timetable, msrtc bus fare, shivshahi bus timetable, shivneri volvo bus timings, maharashtra st bus stand contact numbers, swargate st stand phone number, mumbai central bus depot enquiry number, एसटी बस वेळापत्रक, शिवशाही बस, एसटी बस चौकशी क्रमांक, msrtc online ticket booking',
  path,
  jsonLd = [],
  htmlLang = 'en-IN',
  breadcrumbs = []
} = Astro.props;

const AD_CLIENT = SITE_CONFIG.adClient;
const GA_ID = SITE_CONFIG.gaId;
const canonical = `${SITE}${path}`;
const shareImage = `${SITE}/images/hero-msrtc.jpg`;

// The bus operator is its own entity: this site is an independent publisher that writes about it.
const msrtcEntity = {
  '@type': 'GovernmentOrganization',
  '@id': `${SITE}/#msrtc`,
  name: SITE_CONFIG.corporationFull,
  alternateName: ['MSRTC', 'ST Mahamandal', 'महाराष्ट्र राज्य मार्ग परिवहन महामंडळ'],
  url: SITE_CONFIG.officialSite,
  areaServed: 'Maharashtra, India',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '1800-22-1250',
    contactType: 'customer support',
    areaServed: 'IN-MH',
  },
};

const baseJsonLd: unknown[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE}/#publisher`,
    name: 'MSRTC ST Bus Info',
    url: `${SITE}/`,
    logo: `${SITE}/icons/icon-512.png`,
    description: 'Independent passenger guide to MSRTC buses. Not affiliated with Maharashtra State Road Transport Corporation.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE}/#website`,
    name: 'MSRTC ST Bus Info',
    url: `${SITE}/`,
    description: 'Independent guide to MSRTC bus timetables, fares, the helpline and bus stand contact numbers.',
    inLanguage: htmlLang,
    publisher: { '@id': `${SITE}/#publisher` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: htmlLang,
    dateModified: LAST_UPDATED,
    isPartOf: { '@id': `${SITE}/#website` },
    publisher: { '@id': `${SITE}/#publisher` },
    about: msrtcEntity,
    primaryImageOfPage: shareImage,
  },
  ...(breadcrumbs.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.label,
          item: `${SITE}${b.href === '/' ? '/' : b.href}`,
        })),
      }]
    : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang={htmlLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="google-adsense-account" content={AD_CLIENT} />

<!-- Google Analytics 4 -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
<script is:inline define:vars={{ GA_ID }}>window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); } gtag('js', new Date()); gtag('config', GA_ID);</script>

<!-- Google Fonts: Space Grotesk (Display), DM Sans (Body), DM Mono (Metadata) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

<!-- AdSense Script -->
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CLIENT}`} crossorigin="anonymous"></script>

<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />

<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="MSRTC ST Bus Info" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="en_IN" />
<meta property="og:image" content={shareImage} />
<meta property="og:image:width" content="1400" />
<meta property="og:image:height" content="781" />
<meta property="og:image:alt" content="Illustration of a red MSRTC Shivshahi bus on a Maharashtra ghat road" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImage} />

<!-- Theme Colors & Favicons -->
<meta name="theme-color" content="#152339" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="48x48" href="/icons/icon-48.png" />
<link rel="icon" type="image/png" sizes="96x96" href="/icons/icon-96.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />

<!-- JSON-LD Structured Data -->
{baseJsonLd.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
</head>
<body>

<!-- Accessible Skip Link -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- 1. Top Utility Line -->
<div class="top-utility-bar">
  <div class="wrap top-utility-inner">
    <div class="utility-badge-text">
      <svg width="14" height="10" viewBox="0 0 24 16" fill="none" aria-hidden="true">
        <rect width="24" height="5.33" fill="#FF9933"/>
        <rect y="5.33" width="24" height="5.34" fill="#FFFFFF"/>
        <rect y="10.67" width="24" height="5.33" fill="#138808"/>
        <circle cx="12" cy="8" r="2.2" stroke="#000080" stroke-width="0.7"/>
      </svg>
      <span>Independent MSRTC bus guide · Not an official MSRTC website</span>
    </div>
    <div class="utility-emergency-links">
      <a class="utility-tel-link" href="tel:1800221250">Helpline: 1800-22-1250</a>
      <a class="utility-tel-link" href="tel:112">Emergency: 112</a>
    </div>
  </div>
</div>

<!-- 2. Sticky Glass Header -->
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand-link" aria-label="MSRTC ST Bus Info Home">
      <div class="brand-mark">
        <span style="font-family:var(--font-display);font-weight:700;font-size:0.95rem;color:#ffffff;letter-spacing:0.02em;">MSRTC</span>
      </div>
      <div class="brand-text-block">
        <span class="brand-title">MSRTC ST Info</span>
        <span class="brand-subtitle">Maharashtra State Transport</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="/" class="nav-link">Home</a>
      <a href="/routes" class="nav-link">Timetables &amp; Routes</a>
      <a href="/stations" class="nav-link">Bus Stations</a>
      <a href="/msrtc-bus-fare" class="nav-link">Bus Fares</a>
      <a href="/msrtc-online-ticket-booking" class="nav-link">Online Booking</a>
      <a href="/msrtc-helpline-number" class="nav-link">Helpline</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="tel:1800221250" class="btn-primary-dial" aria-label="Call 24x7 MSRTC Helpline 1800-22-1250">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>1800-22-1250</span>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="mobile-toggle" id="mobile-menu-btn" aria-label="Toggle Navigation Menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <nav class="wrap mobile-nav-links" aria-label="Mobile Navigation">
      <a href="/" class="mobile-nav-item">Home Directory</a>
      <a href="/routes" class="mobile-nav-item">Bus Timetables &amp; Routes (30)</a>
      <a href="/stations" class="mobile-nav-item">Bus Stands &amp; Regions (20)</a>
      <a href="/msrtc-bus-fare" class="mobile-nav-item">Bus Fares &amp; Concessions</a>
      <a href="/msrtc-online-ticket-booking" class="mobile-nav-item">Online Ticket Booking</a>
      <a href="/msrtc-helpline-number" class="mobile-nav-item">24x7 Helpline &amp; Grievances</a>
      <div style="padding-top:1rem;border-top:1px solid var(--border);">
        <a href="tel:1800221250" class="btn-primary-dial" style="justify-content:center;width:100%;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Call MSRTC Helpline: 1800-22-1250</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Breadcrumbs Bar (if provided) -->
{breadcrumbs.length > 0 && (
  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="wrap">
      <ol class="breadcrumb-list">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        {breadcrumbs.map((b, i) => (
          <li class="breadcrumb-item">
            <span class="breadcrumb-sep" aria-hidden="true">/</span>
            {i === breadcrumbs.length - 1 ? (
              <span aria-current="page">{b.label}</span>
            ) : (
              <a href={b.href}>{b.label}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<!-- Main Content Slot -->
<main id="main-content">
  <slot />
</main>

<!-- Institutional Footer -->
<footer class="site-footer">
  <div class="wrap footer-top">
    <div>
      <div class="footer-brand-title">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:4px;background:#d9381e;color:#fff;font-size:0.75rem;font-weight:700;">MH</span>
        <span>MSRTC ST Bus Info</span>
      </div>
      <p class="footer-brand-desc">
        Independent passenger guide compiled from publicly available MSRTC information. Find bus stand enquiry numbers, Shivneri and Shivshahi route references, and welfare concessions across Maharashtra.
      </p>
    </div>

    <div>
      <h3 class="footer-heading">MSRTC Guides</h3>
      <ul class="footer-links">
        <li><a href="/msrtc-bus-timetable">MSRTC Bus Timetable</a></li>
        <li><a href="/msrtc-bus-fare">MSRTC Bus Fare &amp; Concessions</a></li>
        <li><a href="/msrtc-online-ticket-booking">Online Ticket Booking</a></li>
        <li><a href="/msrtc-helpline-number">24x7 Customer Care</a></li>
        <li><a href="/routes">30 Popular Bus Routes</a></li>
        <li><a href="/stations">20 Major Regions</a></li>
      </ul>
    </div>

    <div>
      <h3 class="footer-heading">Top Transport Divisions</h3>
      <ul class="footer-links">
        <li><a href="/pune-bus-station-contact-number">Pune (Swargate &amp; Wakad)</a></li>
        <li><a href="/mumbai-bus-station-contact-number">Mumbai Central &amp; Dadar</a></li>
        <li><a href="/thane-bus-station-contact-number">Thane Vandana &amp; CBS</a></li>
        <li><a href="/nashik-bus-station-contact-number">Nashik CBS Thakkar Bazar</a></li>
        <li><a href="/chhatrapati-sambhajinagar-bus-station-contact-number">Chhatrapati Sambhajinagar</a></li>
        <li><a href="/kolhapur-bus-station-contact-number">Kolhapur Central Stand</a></li>
        <li><a href="/nagpur-bus-station-contact-number">Nagpur Ganeshpeth Stand</a></li>
      </ul>
    </div>

    <div>
      <h3 class="footer-heading">Sister Transport Portals</h3>
      <ul class="footer-links">
        <li><a href="https://rtc.shivrajsinh.in" target="_blank" rel="noopener">National RTC Directory</a></li>
        <li><a href="https://gsrtc.shivrajsinh.in" target="_blank" rel="noopener">GSRTC Gujarat ST Info</a></li>
        <li><a href="https://transit.shivrajsinh.in" target="_blank" rel="noopener">Stopwatch Transit (123 Systems)</a></li>
        <li><a href="/about">About This Site</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/sitemap-index.xml">Sitemap XML</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>
      © 2026 MSRTC ST Bus Info. Independent public information resource compiled from public transport records. Not affiliated with or endorsed by Maharashtra State Road Transport Corporation (MSRTC). Please verify departure timings with station masters before commencing critical journeys.
    </p>
  </div>
</footer>

<!-- Interactive Scripts: Mobile Nav, AdSense Lazy Loader, Phone Copy Toast -->
<script type="module">
  // Mobile Nav Drawer Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-nav-drawer');
  if (mobileBtn && drawer) {
    mobileBtn.addEventListener('click', () => {
      const open = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', String(!open));
      drawer.classList.toggle('open');
    });
  }

  // Lazy Ad Loading with IntersectionObserver
  function setupLazyAds() {
    const adWraps = document.querySelectorAll('.ad-slot-wrap');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const ins = entry.target.querySelector('ins.adsbygoogle');
            if (ins && !ins.dataset.loaded) {
              ins.dataset.loaded = 'true';
              try {
                (window.adsbygoogle = window.adsbygoogle || []).push({});
              } catch (e) {}
            }
            obs.unobserve(entry.target);
          }
        });
      }, { rootMargin: '600px 0px' });
      adWraps.forEach(w => observer.observe(w));
    } else {
      document.querySelectorAll('ins.adsbygoogle').forEach(ins => {
        try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLazyAds);
  } else {
    setupLazyAds();
  }
</script>

</body>
</html>
