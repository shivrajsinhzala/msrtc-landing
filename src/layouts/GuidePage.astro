---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE_CONFIG } from '../config/site.mjs';

interface Props {
  guide: { slug: string; title: string; description: string; h1: string; bodyHtml: string; faq?: { q: string; a: string }[] };
  path: string;
  otherGuides: { href: string; label: string }[];
}

const { guide, path, otherGuides } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: guide.title,
    description: guide.description,
    about: { '@type': 'Organization', name: SITE_CONFIG.corporationFull },
  },
];

if (guide.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}

const breadcrumbs = [
  { label: 'Guides', href: '/' },
  { label: guide.title.split('—')[0].trim(), href: path },
];
---

<Base title={guide.title} description={guide.description} path={path} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>

  <div class="wrap" style="padding-top:1.5rem;padding-bottom:3rem;max-width:840px;">

    <div style="font-family:var(--font-mono);font-size:0.75rem;font-weight:700;color:var(--primary-blue);text-transform:uppercase;letter-spacing:0.04em;margin-bottom:0.35rem;">
      MSRTC Official Utility Guide · Maharashtra State Transport
    </div>

    <h1 class="section-title" style="font-size:2.2rem;margin-bottom:1rem;" set:html={guide.h1} />

    <!-- Above-The-Fold Ad Slot -->
    <AdSlot slotId="5213571252" label="Advertisement" />

    <!-- Guide Body Copy -->
    <article class="guide-content-article" style="line-height:1.75;font-size:1.02rem;color:var(--ink);margin:2rem 0;">
      <Fragment set:html={guide.bodyHtml} />
    </article>

    <!-- Mid-Content Ad Slot -->
    <AdSlot slotId="5213571252" label="Sponsored" />

    <!-- Questions People Ask (FAQ) -->
    {guide.faq && guide.faq.length > 0 && (
      <section style="margin:2.5rem 0;">
        <h2 class="section-title" style="font-size:1.55rem;margin-bottom:1rem;">Questions People Ask</h2>
        <div style="display:flex;flex-direction:column;gap:1rem;">
          {guide.faq.map(({ q, a }) => (
            <div class="card" style="margin:0;">
              <h3 style="font-size:1.02rem;margin-bottom:0.35rem;color:var(--ink);">{q}</h3>
              <p style="font-size:0.9rem;line-height:1.6;color:var(--slate);margin:0;">{a}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- More MSRTC Guides -->
    {otherGuides.length > 0 && (
      <section style="margin:2.5rem 0;padding-top:1.5rem;border-top:1px solid var(--border);">
        <h2 class="section-title" style="font-size:1.35rem;margin-bottom:1rem;">More MSRTC Information Guides</h2>
        <div class="rtc-grid" style="grid-template-columns:repeat(auto-fill, minmax(240px, 1fr));">
          {otherGuides.map((g) => (
            <a class="rtc-card" href={g.href} style="padding:1rem;">
              <h3 class="rtc-card-title" style="font-size:1rem;">{g.label}</h3>
              <div class="rtc-card-meta" style="margin-top:0.5rem;">
                <span style="color:var(--primary-blue);font-weight:600;font-size:0.82rem;">Read guide</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>

</Base>
